# Root .env (shared by api and app)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DEFINDEX_API_KEY=
ETHERFUSE_API_KEY=
# Must equal the Issuer URL registered in the Etherfuse dashboard's Partner JWT section (also serves the JWKS URL there).
ETHERFUSE_JWT_ISSUER=
# Must match a `kid` in the JWKS registered at that dashboard's JWKS URL (which must serve Content-Type: application/json).
ETHERFUSE_JWT_KID=
# RSA (RS256, NOT ES256 — sandbox rejects ES256) PKCS8 PEM, \n-escaped newlines, in double quotes.
ETHERFUSE_JWT_PRIVATE_KEY=
# generated by spike scripts if absent (testnet only)
SPONSOR_SECRET_KEY=
# 'testnet' (default) or 'mainnet' — selects Horizon, passphrase, asset
# registry, vault, and the Etherfuse endpoints/asset in one switch. Mainnet
# needs production Etherfuse credentials and a mainnet-funded sponsor key.
STELLAR_NETWORK=
# Soroban RPC endpoint. Optional on testnet (defaults to the public SDF
# testnet RPC); REQUIRED on mainnet, which has no free public RPC.
SOROBAN_RPC_URL=
# API server log level: fatal|error|warn|info|debug|trace|silent (default info)
LOG_LEVEL=
# Frontend variables (VITE_* prefix)
VITE_PRIVY_APP_ID=
# Keep in sync with STELLAR_NETWORK — drives asset labels + explorer links.
VITE_STELLAR_NETWORK=
